{
  "manifest_version": 3,
  "name": "DataFog (prototype)",
  "version": "0.0.1",
  "description": "Prototype: checks prompts typed into ChatGPT for sensitive data, locally, before you send them.",
  "permissions": ["storage", "sidePanel"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open DataFog"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}

{
  "name": "datafog-browser-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Local DataFog checks for prompts typed into ChatGPT, Claude, Gemini, Grok and DeepSeek",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:integration": "npm run build && playwright test",
    "test:e2e": "npm run test:integration",
    "test:e2e:report": "playwright show-report",
    "test:live:auth": "npm run build && node scripts/chatgpt-auth.mjs",
    "test:e2e:live": "node scripts/run-live-tests.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@datafog/core-fogvault-browser": "^1.6.0",
    "@datafog/fogvault-browser": "0.1.0",
    "@datafog/wasm": "^1.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/chrome": "0.3.6",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

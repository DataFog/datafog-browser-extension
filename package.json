{
  "name": "datafog-browser-extension",
  "version": "0.0.1",
  "private": true,
  "description": "Prototype: local DataFog checks for prompts typed into ChatGPT",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@datafog/core-fogvault-browser": "1.1.0",
    "@datafog/fogvault-browser": "0.1.0",
    "@datafog/wasm": "1.1.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.6",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
